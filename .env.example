# YouTube Data API v3 Configuration
# Copy this file to .env and fill in your values.
#
# NOTE: VITE_ prefixed variables are embedded in the client bundle.
# They are NOT secret. Restrict your API key in Google Cloud Console:
#   - HTTP referrer restrictions
#   - API restriction to YouTube Data API v3 only
#   - Daily quota limit

VITE_YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
VITE_YOUTUBE_API_KEY=YOUR_API_KEY_HERE
